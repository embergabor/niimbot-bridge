#!/bin/sh
# Runs as root before files are laid down: stop a running proxy (upgrade case).
LABEL=local.niimbot-proxy
for uid in $(ps -axo uid=,comm= | awk '$2 ~ /loginwindow$/ {print $1}' | sort -u); do
  launchctl bootout "gui/$uid/$LABEL" 2>/dev/null || true
done
pkill -x NiimbotProxy 2>/dev/null || true
rm -rf "/Library/Application Support/NiimbotProxy/apps"
exit 0
